if(COMANCHECD_BUILD_OPENGL OR COMANCHECD_BUILD_OPENXR)
    if(COMANCHECD_BUILD_OPENXR)
        find_package(OpenGL REQUIRED)
    else()
        find_package(OpenGL QUIET)
    endif()
    if(TARGET OpenGL::GL)
        add_library(comanchecd_glscene host/gl_scene.cpp)
        target_include_directories(comanchecd_glscene PUBLIC host)
        target_link_libraries(comanchecd_glscene PUBLIC comanchecd_spatial PRIVATE ${COMANCHECD_SDL2_TARGET} OpenGL::GL)
    elseif(COMANCHECD_BUILD_OPENGL)
        message(STATUS "OpenGL unavailable; enhanced desktop will use the CPU renderer")
    endif()
endif()
