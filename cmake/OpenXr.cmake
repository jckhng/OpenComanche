find_path(COMANCHECD_OPENXR_INCLUDE_DIR NAMES openxr/openxr.h)
if(NOT COMANCHECD_OPENXR_INCLUDE_DIR)
    message(FATAL_ERROR "Set COMANCHECD_OPENXR_INCLUDE_DIR to the OpenXR SDK include directory")
endif()
find_package(OpenGL REQUIRED)
find_package(Threads REQUIRED)
add_library(comanchecd_openxr host/openxr_runtime.cpp host/openxr_session.cpp host/openxr_graphics.cpp host/openxr_host.cpp)
target_include_directories(comanchecd_openxr PUBLIC host)
target_include_directories(comanchecd_openxr SYSTEM PUBLIC "${COMANCHECD_OPENXR_INCLUDE_DIR}")
target_link_libraries(comanchecd_openxr PUBLIC comanchecd_sdl2 PRIVATE ${COMANCHECD_SDL2_TARGET} OpenGL::GL Threads::Threads)
if(UNIX AND NOT APPLE)
    find_package(X11 REQUIRED)
    target_include_directories(comanchecd_openxr SYSTEM PRIVATE ${X11_INCLUDE_DIR})
    target_link_libraries(comanchecd_openxr PRIVATE ${X11_LIBRARIES})
endif()
target_link_libraries(comanche_viewer PRIVATE comanchecd_openxr)
target_compile_definitions(comanche_viewer PRIVATE COMANCHECD_OPENXR_RUNTIME)
if(BUILD_TESTING)
    add_executable(openxr_runtime_tests tests/openxr_runtime_tests.cpp)
    target_link_libraries(openxr_runtime_tests PRIVATE comanchecd_openxr)
    add_test(NAME openxr_runtime_tests COMMAND openxr_runtime_tests)
    add_executable(openxr_session_tests tests/openxr_session_tests.cpp)
    target_link_libraries(openxr_session_tests PRIVATE comanchecd_openxr)
    add_test(NAME openxr_session_tests COMMAND openxr_session_tests)
    add_executable(openxr_graphics_tests tests/openxr_graphics_tests.cpp)
    target_link_libraries(openxr_graphics_tests PRIVATE comanchecd_openxr ${COMANCHECD_SDL2_TARGET} OpenGL::GL)
    add_test(NAME openxr_graphics_tests COMMAND openxr_graphics_tests)
    set_tests_properties(openxr_graphics_tests PROPERTIES SKIP_RETURN_CODE 77)
endif()
