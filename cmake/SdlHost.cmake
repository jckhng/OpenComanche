find_package(SDL2 2.0.10 CONFIG QUIET)
if(TARGET SDL2::SDL2)
    set(COMANCHECD_SDL2_TARGET SDL2::SDL2)
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(SDL2 REQUIRED IMPORTED_TARGET "sdl2>=2.0.10")
    set(COMANCHECD_SDL2_TARGET PkgConfig::SDL2)
endif()
function(comanchecd_player target)
    if(MINGW)
        target_link_options(${target} PRIVATE -static)
    endif()
    install(TARGETS ${target} RUNTIME DESTINATION .)
endfunction()

add_library(comanchecd_viewer host/viewer.cpp)
target_include_directories(comanchecd_viewer PUBLIC host)
target_link_libraries(comanchecd_viewer PUBLIC comanchecd_renderer)
add_library(comanchecd_app host/session_app.cpp host/launch_options.cpp)
target_include_directories(comanchecd_app PUBLIC host)
target_link_libraries(comanchecd_app PUBLIC comanchecd_viewer)
add_library(comanchecd_devices host/sdl_audio.cpp host/sdl_keyboard.cpp)
target_include_directories(comanchecd_devices PUBLIC host)
target_link_libraries(comanchecd_devices PUBLIC comanchecd_renderer PRIVATE ${COMANCHECD_SDL2_TARGET})
add_library(comanchecd_faithful host/faithful_sdl_host.cpp host/sdl_presenter.cpp)
target_include_directories(comanchecd_faithful PUBLIC host)
target_compile_definitions(comanchecd_faithful PRIVATE COMANCHECD_INDEXED_ONLY)
target_link_libraries(comanchecd_faithful PUBLIC comanchecd_devices PRIVATE ${COMANCHECD_SDL2_TARGET})
add_executable(comanche_faithful host/faithful_main.cpp)
target_link_libraries(comanche_faithful PRIVATE comanchecd_app comanchecd_faithful)
comanchecd_player(comanche_faithful)
add_executable(training_viewer host/main.cpp)
target_link_libraries(training_viewer PRIVATE comanchecd_viewer comanchecd_faithful)

if(BUILD_TESTING)
    add_executable(viewer_tests tests/viewer_tests.cpp)
    target_link_libraries(viewer_tests PRIVATE comanchecd_viewer)
    add_executable(launch_options_tests tests/launch_options_tests.cpp)
    target_link_libraries(launch_options_tests PRIVATE comanchecd_app)
    add_test(NAME launch_options_tests COMMAND launch_options_tests)
    add_executable(faithful_host_tests tests/sdl_host_tests.cpp)
    target_compile_definitions(faithful_host_tests PRIVATE COMANCHECD_TEST_FAITHFUL)
    target_link_libraries(faithful_host_tests PRIVATE comanchecd_faithful ${COMANCHECD_SDL2_TARGET})
    add_test(NAME faithful_host_tests COMMAND faithful_host_tests)
    set_tests_properties(faithful_host_tests PROPERTIES
        ENVIRONMENT "SDL_VIDEODRIVER=dummy;SDL_AUDIODRIVER=dummy;SDL_RENDER_DRIVER=software")
    add_test(NAME launch_binary_tests COMMAND ${CMAKE_COMMAND}
        -DFAITHFUL=$<TARGET_FILE:comanche_faithful>
        -DENHANCED=$<IF:$<BOOL:${COMANCHECD_BUILD_ENHANCED}>,${CMAKE_CURRENT_BINARY_DIR}/comanche_enhanced${CMAKE_EXECUTABLE_SUFFIX},>
        -DOPENXR=$<IF:$<BOOL:${COMANCHECD_BUILD_OPENXR}>,${CMAKE_CURRENT_BINARY_DIR}/comanche_openxr${CMAKE_EXECUTABLE_SUFFIX},>
        -P ${CMAKE_CURRENT_SOURCE_DIR}/tests/launch_binary_tests.cmake)
endif()

if(COMANCHECD_BUILD_ENHANCED OR COMANCHECD_BUILD_OPENXR)
    include(cmake/EnhancedSdl.cmake)
endif()
if(TARGET audio_probe AND NOT TARGET comanchecd_sdl2)
    target_compile_definitions(audio_probe PRIVATE COMANCHECD_SDL2_AUDIO)
    target_link_libraries(audio_probe PRIVATE comanchecd_devices)
endif()

install(FILES PREVIEW.md DESTINATION . RENAME README.md)
install(FILES LICENSE-MIT DESTINATION .)
install(FILES third_party/dbopl/COPYING third_party/SDL2-LICENSE.txt DESTINATION .)
install(DIRECTORY include src host tests third_party cmake DESTINATION source)
install(FILES CMakeLists.txt BUILDING.md PREVIEW.md ARCHITECTURE.md THIRD_PARTY.md LICENSE-MIT DESTINATION source)
if(WIN32 AND TARGET SDL2::SDL2)
    install(FILES $<TARGET_FILE:SDL2::SDL2> DESTINATION .)
    foreach(target training_viewer comanche_faithful comanche_enhanced comanche_openxr
        audio_probe faithful_host_tests desktop_view_tests gl_desktop_tests sdl_host_tests
        enhanced_host_tests host_preferences_tests sdl_presenter_tests sdl_keyboard_route
        openxr_runtime_tests openxr_session_tests openxr_graphics_tests)
        if(TARGET ${target})
            add_custom_command(TARGET ${target} POST_BUILD
                COMMAND ${CMAKE_COMMAND} -E copy_if_different $<TARGET_FILE:SDL2::SDL2> $<TARGET_FILE_DIR:${target}>)
        endif()
    endforeach()
endif()
