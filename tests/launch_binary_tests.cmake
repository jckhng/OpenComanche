function(check_help executable name)
    execute_process(COMMAND "${executable}" --help RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "${name} INSTALLATION PAYLOAD_DIRECTORY PROFILE_DIRECTORY")
        message(FATAL_ERROR "${name} help failed (${result}) ${output} ${error}")
    endif()
endfunction()

function(check_rejected executable expected)
    execute_process(COMMAND "${executable}" unused-installation unused-payload unused-profile ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "${expected}")
        message(FATAL_ERROR "Mode boundary failed (${result}) ${output} ${error}")
    endif()
    if(EXISTS unused-profile)
        message(FATAL_ERROR "Rejected options created a profile")
    endif()
endfunction()

check_help("${FAITHFUL}" comanche_faithful)
check_rejected("${FAITHFUL}" "executable fixes its mode" --mode enhanced)
check_rejected("${FAITHFUL}" "Faithful accepts" --renderer gpu)
check_rejected("${FAITHFUL}" "Faithful accepts" --xr on)
if(ENHANCED)
    check_help("${ENHANCED}" comanche_enhanced)
    check_rejected("${ENHANCED}" "executable fixes its mode" --mode faithful)
    check_rejected("${ENHANCED}" "XR options require comanche_openxr" --xr on)
endif()
if(OPENXR)
    check_help("${OPENXR}" comanche_openxr)
    check_rejected("${OPENXR}" "requires XR presentation" --xr off)
    check_rejected("${OPENXR}" "executable fixes its mode" --mode faithful)
endif()
